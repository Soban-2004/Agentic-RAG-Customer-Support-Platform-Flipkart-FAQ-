      "html": "<button class=\"ds-sidebar-new\">+ New conversation</button>",
      "css": ".ds-sidebar-new { display:flex;gap:9px;align-items:center;justify-content:center;width:100%;padding:12px 15px;background:var(--brand-soft);color:var(--brand);border:1px solid var(--border);border-radius:10px;font-size:13px;font-weight:600;transition:background .18s,color .18s; } .ds-sidebar-new:hover { background:var(--brand);color:var(--button-ink); } :focus-visible { outline:2px solid var(--brand);outline-offset:4px; } @media(prefers-reduced-motion:reduce) { * { animation:none!important;transition:none!important; } }"
    },
    {
