  "components": [
    {
      "name": "Primary action",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Lilac authentication action with a gentle hover lift.",
      "html": "<button class=\"ds-primary-button\">Continue <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></button>",
      "css": ".ds-primary-button { display:flex;align-items:center;justify-content:space-between;gap:12px;border:0;background:var(--brand);color:var(--button-ink);border-radius:8px;padding:13px 16px;font-size:13px;font-weight:600;transition:background .2s,transform .2s; } .ds-primary-button:hover:not(:disabled) { background:var(--brand-hover);transform:translateY(-1px); } .ds-primary-button:disabled { opacity:.7; } :focus-visible { outline:2px solid var(--brand);outline-offset:4px; } @media(prefers-reduced-motion:reduce) { * { animation:none!important;transition:none!important; } }"
    },
    {
      "name": "Secondary action",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Bordered alternate entry action.",
      "html": "<a class=\"ds-secondary-button\" href=\"#demo\">Try the demo</a>",
      "css": ".ds-secondary-button { display:flex;justify-content:center;align-items:center;gap:12px;color:var(--ink);border:1px solid var(--border);padding:12px 16px;border-radius:8px;font-size:12px;transition:background .2s; } .ds-secondary-button:hover { background:var(--hover); } :focus-visible { outline:2px solid var(--brand);outline-offset:4px; } @media(prefers-reduced-motion:reduce) { * { animation:none!important;transition:none!important; } }"
    },
