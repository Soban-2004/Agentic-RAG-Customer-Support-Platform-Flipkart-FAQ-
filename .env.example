# Copy values into your deployment secret manager, not into a built image.
APP_ENV=development
PUBLIC_BASE_PATH=/
DATABASE_URL=postgresql://app:replace-me@localhost:5432/aster
POSTGRES_PASSWORD=replace-with-a-strong-database-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CHATGROQ_API_KEY=replace-me
COHERE_API_KEY=replace-me
AGENT_TOOL_CALL_MODEL_KEY=fallback
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
KNOWLEDGE_ALIAS=flipkart_faqs_live
# Required in production; exact HTTPS origins, no wildcards.
TRUSTED_ORIGINS=https://your-app.example
# Match the actual trusted reverse proxy, never unconditionally trust the internet.
FORWARDED_ALLOW_IPS=127.0.0.1
BUSINESS_BACKEND=demo
ENABLE_DEMO=true
ENABLE_CONTENT_TRACING=false
ENABLE_SHARED_FAQ_CACHE=false
DB_POOL_SIZE=12
MAX_CONCURRENT_TURNS=4
CHAT_PER_HOUR=60
DAILY_TURN_LIMIT=500
DAILY_IMAGE_LIMIT=30
DAILY_RESERVED_TOKEN_LIMIT=10000000
ACCOUNT_DAILY_RESERVED_TOKEN_LIMIT=2000000
TURN_TIMEOUT_SECONDS=90
WS_IDLE_TIMEOUT_SECONDS=300
MAX_CONNECTIONS=50
MAX_FRAME_BYTES=6000000
